# Copy to .env and fill in. Never commit .env.

# REQUIRED in production — signs report links. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
AUDITA_SECRET_KEY=

# Comma-separated allowed browser origins. Empty = same-origin only (single-container deploy).
AUDITA_CORS_ORIGINS=

# Report link lifetime in seconds (default 7 days).
AUDITA_LINK_MAX_AGE=604800

# Optional: enables the Vision Agent (scanned-invoice extraction) and the ADK agent.
GEMINI_API_KEY=

# Optional overrides
# AUDITA_DATA_DIR=/data
# AUDITA_VISION_MODEL=gemini-2.5-flash
