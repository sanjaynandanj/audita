# Copy to .env and fill in. Never commit .env.

# REQUIRED in production — signs report links. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
AUDITA_SECRET_KEY=

# Comma-separated allowed browser origins. Empty = same-origin only (single-container deploy).
AUDITA_CORS_ORIGINS=

# Report link lifetime in seconds (default 7 days).
AUDITA_LINK_MAX_AGE=604800

# Postgres connection. Default targets the docker-compose postgres service
# (localhost:5434 from the host; compose overrides this for the app container).
# Prod (Cloud Run + Cloud SQL): postgresql://USER:PASS@/audita?host=/cloudsql/INSTANCE
AUDITA_DATABASE_URL=postgresql://audita:audita@localhost:5434/audita

# Optional: enables the Vision Agent (scanned-invoice extraction) and the ADK agent.
GEMINI_API_KEY=

# Optional overrides
# AUDITA_DATA_DIR=/data
# AUDITA_VISION_MODEL=gemini-2.5-flash
# AUDITA_MAX_UPLOAD_MB=15
# AUDITA_COOKIE_SECURE=1          # set 0 only for plain-HTTP LAN testing
# AUDITA_AGENT_ORG_ID=            # org UUID for the conversational ADK agent
